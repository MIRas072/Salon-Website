rules_version = '2';

// Правила безопасности базы заявок.
// Доступ администратора разрешён указанной ниже почте Firebase Authentication.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "jokkerazirali@gmail.com";
    }

    function validPublicBooking() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'phone', 'service', 'masterId', 'date', 'time', 'comment', 'status', 'source', 'createdAt'])
        && d.keys().hasAll(['name', 'phone', 'service', 'masterId', 'date', 'time', 'status', 'source', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.phone is string && d.phone.size() >= 6 && d.phone.size() <= 20
        && d['service'] is string && d['service'].size() > 0 && d['service'].size() <= 80
        && validAppointment(d)
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
        && d.status == 'new'
        && d.source == 'site'
        && d.createdAt == request.time;
    }

    function active(d) {
      return d.status in ['new', 'confirmed'];
    }

    function slotId(d) {
      return d.masterId + '_' + d.date + '_' + d.time;
    }

    function validAppointment(d) {
      let male = ['Мужская стрижка', 'Детская стрижка (мужской зал)', 'Модельная стрижка'];
      let all = ['Женская стрижка', 'Детская стрижка (женский зал)', 'Окрашивание в один тон',
        'Омбре / Шатуш / Балаяж', 'Тонировка', 'Укладка', 'Локоны', 'Причёска',
        'Мужская стрижка', 'Детская стрижка (мужской зал)', 'Модельная стрижка', 'Свадебный образ'];
      return d.masterId is string && d['service'] in all
        && (d.masterId == 'master-1'
          || (d.masterId == 'master-2' && d['service'] != 'Свадебный образ')
          || (d.masterId == 'master-3' && d['service'] in male))
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.time is string && d.time.matches('1[0-9]:(00|30)');
    }

    function hasReservation(d, id) {
      let s = getAfter(/databases/$(database)/documents/availability/$(slotId(d))).data;
      return s.bookingId == id && s.masterId == d.masterId && s.date == d.date && s.time == d.time;
    }

    function releasedPrevious(id) {
      let old = resource.data;
      return !('masterId' in old) || !active(old)
        || (active(request.resource.data) && slotId(old) == slotId(request.resource.data))
        || !existsAfter(/databases/$(database)/documents/availability/$(slotId(old)));
    }

    // Заявки: любой посетитель может только создать новую заявку.
    // Читать, менять и удалять заявки может только администратор.
    match /bookings/{id} {
      allow create: if (isAdmin() && (!active(request.resource.data)
          || (validAppointment(request.resource.data) && hasReservation(request.resource.data, id))))
        || (validPublicBooking()
          && !exists(/databases/$(database)/documents/availability/$(slotId(request.resource.data)))
          && hasReservation(request.resource.data, id));
      allow read: if isAdmin();
      allow update: if isAdmin() && releasedPrevious(id)
        && (!active(request.resource.data)
          || (validAppointment(request.resource.data) && hasReservation(request.resource.data, id)));
      allow delete: if isAdmin() && (!('masterId' in resource.data) || !active(resource.data)
        || !existsAfter(/databases/$(database)/documents/availability/$(slotId(resource.data))));
    }

    // Публичное расписание содержит только время, мастера и технический ID.
    // Имя, телефон, услуга и комментарий здесь не сохраняются.
    match /availability/{slot} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['masterId', 'date', 'time', 'bookingId'])
        && slot == slotId(request.resource.data)
        && request.resource.data.bookingId is string
        && linkedBooking(request.resource.data);
      // Нельзя перезаписать занятое окно даже администратору.
      allow update: if false;
      allow delete: if isAdmin() && reservationReleased(resource.data);
    }

    function linkedBooking(s) {
      let path = /databases/$(database)/documents/bookings/$(s.bookingId);
      let b = getAfter(path).data;
      return (isAdmin() || !exists(path)) && active(b) && validAppointment(b)
        && s.masterId == b.masterId && s.date == b.date && s.time == b.time;
    }

    function reservationReleased(s) {
      let path = /databases/$(database)/documents/bookings/$(s.bookingId);
      return !existsAfter(path) || !active(getAfter(path).data)
        || slotId(getAfter(path).data) != slotId(s);
    }

    // Всё остальное закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
